---
import DownloadIcon from './icons/DownloadIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/skills', label: 'Skills' },
  { href: '/education', label: 'Education' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">Alejandro Blanco</a>

    <ul class="nav-links">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class={path === href ? 'active' : ''}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-right">
      <a
        id="resume-download"
        href="/resume-light.pdf"
        download="Alejandro Blanco - Resume.pdf"
        class="btn-download"
        title="Download Resume"
        aria-label="Download Resume"
      >
        <DownloadIcon size={15} />
        <span class="download-label">Resume</span>
      </a>
      <ThemeToggle />
      <button class="hamburger" id="hamburger" aria-label="Open menu">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <line x1="2" y1="5" x2="18" y2="5"></line>
          <line x1="2" y1="10" x2="18" y2="10"></line>
          <line x1="2" y1="15" x2="18" y2="15"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobileMenu">
  {
    links.map(({ href, label }) => (
      <a href={href} class={path === href ? 'active' : ''}>
        {label}
      </a>
    ))
  }
  <a id="resume-download-mobile" href="/resume-light.pdf" download="Alejandro Blanco - Resume.pdf" class="mobile-download">
    Download Resume
  </a>
</div>

<script>
  const hamburger = document.getElementById('hamburger');
  const menu = document.getElementById('mobileMenu');
  hamburger?.addEventListener('click', () => menu?.classList.toggle('open'));
  menu
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => menu.classList.remove('open')));

  const resumeLinkIds = ['resume-download', 'resume-download-mobile'];

  // Point the desktop and mobile resume links at the PDF matching the current theme.
  function syncResumeLinks() {
    const mode = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    const file = `/resume-${mode}.pdf`;
    const name = 'Alejandro Blanco - Resume.pdf';
    for (const linkId of resumeLinkIds) {
      const resumeLink = document.getElementById(linkId) as HTMLAnchorElement | null;
      if (resumeLink) { resumeLink.href = file; resumeLink.download = name; }
    }
  }

  syncResumeLinks();
  // Watch for class changes on <html> — avoids the race where a click listener
  // reads the old class before the toggle has flipped it.
  new MutationObserver(syncResumeLinks).observe(document.documentElement, {
    attributeFilter: ['class'],
  });
</script>

<style>
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 6px;
    padding: 0.3rem 0.65rem;
    text-decoration: none;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    white-space: nowrap;
  }

  .btn-download:active {
    scale: 0.96;
  }

  .btn-download:hover {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .download-label {
      display: none;
    }
  }

  .mobile-download {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent) !important;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
</style>
